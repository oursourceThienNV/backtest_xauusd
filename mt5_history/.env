MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

DB_HOST=160.30.112.14
DB_PORT=3306
DB_NAME=mt5_backtest
DB_USER=root
DB_PASSWORD=BackTest@2026

MT5_SYMBOL=XAUUSD
# TICK = lưu từng tick gốc (khuyên dùng để tái hiện thị trường)
# S1   = nến 1 giây dựng từ tick
# M1, M5, M15, M30, H1, H4, D1 = nến gốc MT5
TIMEFRAME=TICK
# Lấy bao nhiêu tháng gần nhất (dữ liệu cũ hơn đã có trong DB vẫn được giữ)
MONTHS_BACK=2
DAYS_END=1

# Chỉ dùng cho S1: dựng nến theo BID (mặc định, giống chart MT5) hoặc ASK
S1_PRICE=BID
# Số dòng mỗi lần INSERT
INSERT_BATCH=5000

# Số lần lấy lại tick cho tới khi số tick ổn định (MT5 đang tải lịch sử)
FETCH_RETRIES=6
# Đối chiếu tick với nến M1 gốc của MT5 mỗi ngày (1 = bật, 0 = tắt)
VERIFY_M1=1
